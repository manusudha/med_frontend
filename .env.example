# Base URL of the backend API — the ONLY place the frontend learns where the API lives.
# It is read by src/api/api.js (the common API file).
#
# Local dev: keep "/api" — Vite forwards /api/* to VITE_PROXY_TARGET (no CORS issues,
#            and it also works when you open the app from your phone on the same Wi-Fi).
# Production: full URL of the deployed API, e.g. https://api.yourclinicapp.com/api
#             (or "/api" if Express serves the built app — SERVE_CLIENT=true)
VITE_API_URL=/api

# Dev server only: where the Express API is running
VITE_PROXY_TARGET=http://localhost:5000

# Name shown before the clinic is known (login page, install prompt)
VITE_APP_NAME=Automate Era
